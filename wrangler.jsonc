{
  "name": "leisurecat-tabletop-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-28",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "services": [
  {
    "binding": "ASK_PGH",
    "service": "brass-pittsburgh-room"
  },
  {
    "binding": "ASK_BHAM",
    "service": "brass-birmingham-room"
  },
  {
    "binding": "ASK_ODIN",
    "service": "feast-for-odin-room"
  },
  {
    "binding": "ASK_TL",
    "service": "tragedy-looper-helper"
  },
  {
    "binding": "ASK_ARNAK",
    "service": "lost-ruins-of-arnak-room"
  },
  {
    "binding": "ASK_BOTC",
    "service": "botc-helper"
  },
  {
    "binding": "ASK_AVALON",
    "service": "avalon-helper"
  },
  {
    "binding": "ASK_DUNE",
    "service": "dune-imperium-helper"
  },
  {
    "binding": "ASK_ARK",
    "service": "ark-nova-helper"
  },
  {
    "binding": "ASK_SAKURA",
    "service": "sakura-arms-helper"
  }
],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "PICK_LIMIT", "namespace_id": "1051", "simple": { "limit": 8, "period": 60 } },
    { "name": "REVIEW_LIMIT", "namespace_id": "1052", "simple": { "limit": 6, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "REVIEWS", "class_name": "Reviews" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reviews"] }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "boardgame.leisurecat.cloud", "custom_domain": true }]
}
